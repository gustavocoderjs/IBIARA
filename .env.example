# Server-only. Use .dev.vars locally for Worker bindings. Never NEXT_PUBLIC_*.
# mock = no LLM calls. live uses the authorized keys below and requires a real smoke test.
# Store actual values only in gitignored .dev.vars or server secrets, never in this example.
NEURALAKE_MODE=mock
NEURALAKE_BASE_URL=https://api.neuralake.cloud/v1
# Legacy fallback for CUSTOMER only; prefer the four separate keys below.
NEURALAKE_API_KEY=
NEURALAKE_CUSTOMER_API_KEY=
NEURALAKE_NIKO_API_KEY=
NEURALAKE_CASA_API_KEY=
NEURALAKE_PANELA_API_KEY=
NEURALAKE_MODEL=auto
CROSS_MEMORY_ENABLED=false
AGORA_MODE=mock
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
EXECUTION_MODE=sandbox
